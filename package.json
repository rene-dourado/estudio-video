{
  "name": "estudio-video",
  "version": "2.0.0",
  "private": true,
  "description": "Estúdio de edição de vídeo com Claude Code e Codex, com o Remotion: qualquer tipo e estilo de vídeo, a partir de um briefing. Fork de mackswendhell/studio, sem a Higgsfield.",
  "scripts": {
    "instalar": "node scripts/instalar.mjs",
    "novo": "node scripts/novo-projeto.mjs",
    "estudio": "node scripts/estudio.mjs",
    "studio": "node scripts/estudio.mjs galeria studio",
    "compositions": "node scripts/estudio.mjs galeria compositions",
    "typecheck": "node scripts/estudio.mjs registrar && tsc --noEmit && node scripts/check-split-layouts.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
